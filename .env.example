# Скопируйте в .env.local и заполните значения.
# .env.local не коммитится в git.
# Все URL должны быть HTTPS (для Яндекс.Вебмастер и SEO).

# Основной адрес сайта (только https)
# APP_URL=https://liteh26.ru

# Telegram — заявки с сайта в группу
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP — дублирование заявок на почту (опционально)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
